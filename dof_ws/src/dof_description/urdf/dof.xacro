<link name="link_3_1">
  <inertial>
    <origin xyz="0.0 5.960464899423812e-10 0.07499999970197677" rpy="0 0 0"/>
    <mass value="5.2020356478777865"/>
    <inertia ixx="0.011583" iyy="0.011583" izz="0.003658" ixy="-0.0" iyz="-0.0" ixz="0.0"/>
