    <origin xyz="-7.111982949821138e-16 -0.03565558019427084 0.014974084426305323" rpy="0 0 0"/>
    <mass value="3.262589877210741"/>
    <inertia ixx="0.003411" iyy="0.003281" izz="0.002438" ixy="0.0" iyz="0.000317" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.0 -0.04 -0.345" rpy="0 0 0"/>
    <geometry>
