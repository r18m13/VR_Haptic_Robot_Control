  <collision>
    <origin xyz="-0.0 -0.08 -0.535" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find dof_description)/meshes/link_8_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<joint name="revolute_1" type="continuous">
  <origin xyz="0.0 0.0 0.055" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="link_1_1"/>
  <axis xyz="0.0 0.0 1.0"/>
  <dynamics damping="10.0" friction="10.0"/>
</joint>

<joint name="revolute_2" type="revolute">
  <origin xyz="0.0 0.06 0.04" rpy="0 0 0"/>
  <parent link="link_1_1"/>
  <child link="link_2_1"/>
  <axis xyz="0.0 1.0 0.0"/>
  <limit upper="1.570796" lower="-1.570796" effort="100" velocity="100"/>
  <dynamics damping="10.0" friction="10.0"/>
</joint>

<joint name="rigid_3" type="fixed">
  <origin xyz="0.0 0.04 0.06" rpy="0 0 0"/>
  <parent link="link_2_1"/>
  <child link="link_3_1"/>
  <dynamics damping="10.0" friction="10.0"/>
</joint>

<joint name="revolute_4" type="continuous">
  <origin xyz="0.0 0.0 0.15" rpy="0 0 0"/>
  <parent link="link_3_1"/>
  <child link="link_4_1"/>
  <axis xyz="0.0 0.0 1.0"/>
  <dynamics damping="10.0" friction="10.0"/>
</joint>

<joint name="revolute_5" type="revolute">
  <origin xyz="0.0 -0.06 0.04" rpy="0 0 0"/>
  <parent link="link_4_1"/>
  <child link="link_5_1"/>
  <axis xyz="0.0 -1.0 0.0"/>
  <limit upper="2.356194" lower="-2.356194" effort="100" velocity="100"/>
  <dynamics damping="10.0" friction="10.0"/>
</joint>

<joint name="revolute_6" type="continuous">
  <origin xyz="0.0 -0.04 0.06" rpy="0 0 0"/>
  <parent link="link_5_1"/>
  <child link="link_6_1"/>
  <axis xyz="0.0 0.0 1.0"/>
  <dynamics damping="10.0" friction="10.0"/>
</joint>

<joint name="revolute_7" type="continuous">
  <origin xyz="0.0 0.04 0.04" rpy="0 0 0"/>
  <parent link="link_6_1"/>
  <child link="link_7_1"/>
  <axis xyz="0.0 1.0 0.0"/>
  <dynamics damping="10.0" friction="10.0"/>
</joint>

<joint name="revolute_8" type="continuous">
  <origin xyz="0.0 0.04 0.09" rpy="0 0 0"/>
  <parent link="link_7_1"/>
  <child link="link_8_1"/>
  <axis xyz="0.0 0.0 1.0"/>
  <dynamics damping="10.0" friction="10.0"/>
</joint>

<!--world-->
<link name="world"></link>
<joint name="base_joint" type="fixed">
  <origin xyz="0 0 0" rpy="0 0 0" />
  <parent link="world" />
  <child link="base_link" />
</joint>


</robot>
