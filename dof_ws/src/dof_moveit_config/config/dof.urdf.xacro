<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="dof">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import dof urdf file -->
    <xacro:include filename="$(find dof_description)/urdf/dof.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="dof.ros2_control.xacro" />


    <xacro:dof_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
