  <inertial>
    <origin xyz="0.0 5.960468923982276e-10 0.012499999701976794" rpy="0 0 0"/>
    <mass value="1.2559999812841276"/>
    <inertia ixx="0.000735" iyy="0.000735" izz="0.00134" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.0 -0.08 -0.535" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find dof_description)/meshes/link_8_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
